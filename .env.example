# Discord Developer Portal > Bot > Reset Token 으로 받은 토큰
DISCORD_TOKEN=

# 서버 ID (개발자 모드 켜고 서버 우클릭 > ID 복사). 넣으면 슬래시 명령이 즉시 등록됨
GUILD_ID=

# 최대 타이머 개수 (1~25)
MAX_TIMERS=10
# 보드 메시지 수정 주기(초). 너무 짧으면 디스코드 속도 제한에 걸림. 5 권장
UPDATE_SEC=5
# 진행률 바 길이(칸)
BAR_LEN=20
# 알림 메시지 자동 삭제(초). 0 이면 안 지움
NOTIFY_DELETE_SEC=60
# 시간대 (한국 9)
TZ_HOURS=9
